# Orbitra Environment Configuration Example
# Copy this file to .env or .env.local and configure your values

# ===================================================================
# Google Ads OAuth - Required for 1-Click Connection
# ===================================================================
#
# These credentials enable the seamless "Sign in with Google" flow.
# Without these, users must manually configure Google Cloud Console apps.
#
# How to obtain:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable "Google Ads API" in the API Library
# 4. Go to "Credentials" → "Create Credentials" → "OAuth 2.0 Client ID"
# 5. Application type: "Web application"
# 6. Add this redirect URI: https://your-domain.com/api.php?action=google_ads_oauth_callback
# 7. Copy Client ID and Client Secret below
#
# Developer Token:
# 1. Go to https://ads.google.com/aw/apicenter
# 2. Apply for or copy your existing Developer Token
# 3. Paste below

# Google OAuth2 Client ID (Web application)
ORBITRA_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth2 Client Secret
ORBITRA_GOOGLE_CLIENT_SECRET=your-client-secret-here

# Google Ads API Developer Token
ORBITRA_GOOGLE_DEVELOPER_TOKEN=your-developer-token

# ===================================================================
# Optional: Meta/Facebook OAuth (for Facebook Ads cost import)
# ===================================================================
# ORBITRA_META_APP_ID=your-facebook-app-id
# ORBITRA_META_APP_SECRET=your-facebook-app-secret

# ===================================================================
# Optional: TikTok OAuth (for TikTok Ads cost import)
# ===================================================================
# ORBITRA_TIKTOK_APP_ID=your-tiktok-app-id
# ORBITRA_TIKTOK_APP_SECRET=your-tiktok-app-secret

# ===================================================================
# Optional: SQLite Configuration
# ===================================================================
# Journal mode: WAL (better concurrency) or DELETE (simpler file management)
# ORBITRA_SQLITE_JOURNAL_MODE=WAL
