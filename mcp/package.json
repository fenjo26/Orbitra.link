{
  "name": "orbitra-mcp",
  "version": "1.3.7",
  "description": "Model Context Protocol (MCP) server for the Orbitra Tracker. Lets AI assistants (Claude, etc.) read stats and manage campaigns, offers, domains, sources and landings over the Orbitra API.",
  "type": "module",
  "bin": {
    "orbitra-mcp": "./src/index.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "manifest": "node src/manifest.js",
    "smoke": "node src/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "keywords": [
    "mcp",
    "orbitra",
    "tracker",
    "claude",
    "affiliate",
    "traffic"
  ],
  "license": "MIT"
}
