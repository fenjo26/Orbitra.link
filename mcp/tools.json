          "payout_value": {
            "type": "number"
          },
          "payout_auto": {
            "type": "boolean"
          },
          "allow_rebills": {
            "type": "boolean"
          },
          "capping_limit": {
            "type": "integer"
          },
          "capping_timezone": {
            "type": "string"
          },
          "alt_offer_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "archived"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "handler": "update_offer",
      "steps": [
        "GET get_offer",
        "merge passed fields over current",
        "POST save_offer"
      ]
    }
  ]
