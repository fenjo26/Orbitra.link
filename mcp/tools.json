    {
      "name": "orbitra_update_campaign",
      "description": "Update an existing campaign. Only the fields you pass are changed. Streams/postbacks are preserved automatically unless you explicitly pass new ones (Orbitra replaces streams wholesale on save, so this tool re-reads and merges to avoid wiping them).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Campaign ID to update."
          },
          "name": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "group_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_model": {
            "type": "string",
            "enum": [
              "CPC",
              "CPM",
              "CPA",
              "RevShare"
            ]
          },
          "cost_value": {
            "type": "number"
          },
          "uniqueness_method": {
            "type": "string"
          },
          "uniqueness_hours": {
            "type": "integer"
          },
          "rotation_type": {
            "type": "string",
            "enum": [
              "position",
              "weight"
            ]
          },
          "catch_404_stream_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "streams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offer_id": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "weight": {
                  "type": "integer"
                },
                "is_active": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": {
                  "type": "string",
                  "description": "e.g. 'regular'."
                },
                "position": {
                  "type": "integer"
                },
                "filters": {
                  "type": "array"
                },
                "schema_type": {
                  "type": "string",
                  "description": "e.g. 'redirect'."
                },
                "action_payload": {
                  "type": "string"
                },
                "schema_custom": {
                  "type": "array"
                }
              },
              "additionalProperties": true
            },
            "description": "Replace streams. Omit to keep existing."
          },
          "postbacks": {
            "type": "array",
            "description": "Replace postbacks. Omit to keep existing."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "handler": "update_campaign",
      "steps": [
        "GET get_campaign",
        "merge fields + normalise streams",
        "POST save_campaign"
      ]
    },
    {
      "name": "orbitra_update_offer",
      "description": "Update an existing offer. Only fields you pass are changed (re-reads the offer and merges).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Offer/destination URL."
          },
          "affiliate_network_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "group_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "redirect_type": {
            "type": "string",
            "description": "How the visitor is sent to the offer. One of: 'redirect' (HTTP 302, default), 'js' (client-side window.location), 'meta_refresh' (meta refresh tag), 'frame'/'iframe' (rendered in a full-page iframe), 'form_submit' (auto-submitted POST form), 'preload'/'curl_proxy' (remote page served through this server)."
          },
          "is_local": {
            "type": "boolean"
          },
          "geo": {
            "type": "string",
