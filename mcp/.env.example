# Copy to .env (or set these in your MCP client config) and fill in.

# Base URL of your Orbitra install (no trailing slash). /api.php is appended automatically.
ORBITRA_URL=https://tracker.example.com

# API key from Orbitra UI: Users -> (your user) -> API Keys.
#   * "read"  key  -> read-only tools (stats, lists, reports)
#   * "write" key  -> read + management tools (create/update/delete)
ORBITRA_API_KEY=paste-your-key-here

# Set to 1 ONLY for local dev with a self-signed TLS certificate.
# ORBITRA_INSECURE=0
