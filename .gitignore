# Dependencies
vendor/
node_modules/

# SQLite Database - USER DATA (never overwrite)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
ltt_tracker.sqlite
orbitra_db.sqlite
database.sqlite
orbitra.db



# Geo databases
var/geoip/*

# Runtime cache / locks / logs
var/cache/
var/locks/
var/logs/

# Cloaking feed (downloaded daily by ipranges_cron.php — runtime data)
var/ipranges/

# Uploads
/landings/*
!/landings/.gitkeep
/offers/*
!/offers/.gitkeep

# macOS / OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.idea/
.vscode/

# FUSE temp files (mount artifacts on Linux, show up on this dev box)
.fuse_hidden*

# ZCode session/plans (local agent state, not source)
.zcode/

# Node logs
npm-debug.log
yarn-error.log

# We are NOT ignoring frontend/dist/ because our install.sh script expects 
# the compiled frontend to be downloaded directly from GitHub.

# Runtime state (sessions, locks, caches)
var/

# LeadForge runtime artifacts (staged bundles, built downloads, temp dirs)
data/leadforge_staging/
data/leadforge_downloads/
data/leadforge_tmp/
remote_leadforge_backup/
tests/offers/
# Test database files
database.db
.claude/worktrees/
data/tracker.db
