# CPA.RIP load-test kit — parameters (copy to params.env and fill in).
# This file is sourced by every script in scripts/.

# --- Tracker (SUT) ---
TRACKER_IP=
# Campaign path: http://$TRACKER_IP/$CAMPAIGN_ALIAS?sub1=...&sub2=...
CAMPAIGN_ALIAS=
CAMPAIGN_ID=
ORBITRA_VERSION=
# Redirect target must match the campaign offer URL (checked by pre_run smoke)
# e.g. https://offer.example/?cid=<uuid>
# --- SSH access (read-only + reset) ---
SSH_USER=
# Private key file path, e.g. $ROOT/keys/lt_ed25519 (ed25519, no passphrase)
SSH_KEY=
# Command template to run a read-only SQL query; <SQL> is replaced by the query.
# Tracker-side sudoers: only `sqlite3 -readonly <db>` for this user.
DB_READ_CMD='sudo -n sqlite3 -readonly /path/to/tracker.sqlite <SQL>'
# Command that wipes test data (clicks + caches) and prints "RESET OK".
RESET_CMD=
# --- Tracker behaviour under test ---
XFF_TRUSTED=yes
UNIQUENESS="IP, 24h window"
ORBITRA_DIR=/var/www/orbitra
SPOOL_FILE=/var/www/orbitra/var/spool/clicks.log
PHPFPM_LOG=/var/log/php8.5-fpm.log
WAL_FILE=/var/www/orbitra/orbitra_db.sqlite-wal
# click_debounce_seconds: 2 (default) or 0 = strict CPA.RIP mode
